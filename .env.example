# OpenAlex API Key (REQUIRED)
# Get your free key at: https://openalex.org/settings/api
OPENALEX_API_KEY=your-api-key-here

# MCP Transport Configuration (Optional)
# Options: stdio (default), http
MCP_TRANSPORT=stdio

# HTTP Transport Settings (only used when MCP_TRANSPORT=http)
MCP_HOST=127.0.0.1
MCP_PORT=8000
